{
  "name": "viniper-desktop",
  "version": "2.0.1",
  "private": true,
  "description": "Viniper — focused local Agent workspace",
  "main": "main.js",
  "viniperProfile": "preview",
  "author": "Viniper",
  "license": "MIT",
  "scripts": {
    "check": "node --check main.js && node --check profile-owner.js && node --check preload.js && node --check platform-runtime.js",
    "test:platform": "node --test platform-runtime.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "42.11.8",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.viniper.workstation.preview",
    "productName": "Viniper",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "profile-owner.js",
      "platform-runtime.js",
      "preload.js",
      "package.json",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "viniper-ui",
        "filter": [
          "static/**",
          "scripts/**",
          "harness-runtime/**",
          "server.py",
          "harness_application_port.py",
          "harness_runtime_bridge.js",
          "harness_usage_projection.js",
          "harness_provider_boundary.js",
          "agent_instructions.py",
          "goal_service.py",
          "schedule_host.py",
          "agent_queue.py",
          "agent_run_coordinator.py",
          "context_lifecycle.py",
          "context_usage.py",
          "model-capabilities.json",
          "model_catalog.py",
          "local_agent_contract.py",
          "local_request_guard.py",
          "daily_usage.py",
          "native_project_browser.py",
          "update_manager.py",
          "skill_sync.py",
          "profiles.json",
          "requirements.txt",
          "VERSION",
          "RELEASE_REVISION",
          "README.md",
          "LICENSE",
          "skills-lock.json",
          "start.bat",
          "launch_frontend.ps1",
          "restart_server.ps1",
          "update_source.json"
        ]
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "../static/assets/viniper-harness-circuit-node.ico",
      "artifactName": "Viniper-workstation.${version}.${ext}",
      "signAndEditExecutable": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "Viniper-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "shortcutName": "Viniper workstation",
      "artifactName": "Viniper-workstation-Setup.${ext}",
      "oneClick": true,
      "perMachine": false
    }
  }
}
