{
  "name": "viniper-workstation-desktop",
  "version": "1.8.2",
  "private": true,
  "description": "Isolated Viniper workstation desktop shell.",
  "main": "main.js",
  "viniperProfile": "preview",
  "author": "Viniper",
  "license": "MIT",
  "scripts": {
    "check": "node --check main.js && node --check profile-owner.js && node --check preload.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "42.3.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.viniper.workstation.preview",
    "productName": "Viniper workstation",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "profile-owner.js",
      "preload.js",
      "package.json",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "viniper-ui",
        "filter": [
          "static/**",
          "scripts/**",
          "harness-runtime/**",
          "server.py",
          "harness_application_port.py",
          "harness_runtime_bridge.js",
          "harness_usage_projection.js",
          "harness_provider_boundary.js",
          "agent_host_bridge.py",
          "agent_instructions.py",
          "agent_queue.py",
          "agent_run_coordinator.py",
          "agent_runtime.py",
          "context_lifecycle.py",
          "context_usage.py",
          "model-capabilities.json",
          "daily_usage.py",
          "native_peer.py",
          "native_commands.py",
          "native_stream_protocol.py",
          "native_project_browser.py",
          "update_manager.py",
          "skill_sync.py",
          "wsl_runtime.py",
          "profiles.json",
          "requirements.txt",
          "VERSION",
          "RELEASE_REVISION",
          "README.md",
          "LICENSE",
          "skills-lock.json",
          "start.bat",
          "launch_frontend.ps1",
          "restart_server.ps1",
          "update_source.json"
        ]
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "../static/assets/viniper-harness-circuit-node.ico",
      "artifactName": "Viniper-workstation.${version}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "include": "build/installer.nsh",
      "shortcutName": "Viniper workstation",
      "artifactName": "Viniper-workstation-Setup.${ext}",
      "oneClick": true,
      "perMachine": false
    }
  }
}
