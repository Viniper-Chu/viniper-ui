{
  "name": "viniper",
  "version": "2.0.0",
  "private": true,
  "description": "Viniper — focused local Agent workspace",
  "main": "dist/src/platform/desktop/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-assets.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "start": "npm run build && electron resources/viniper-ui/desktop/main.js",
    "setup:electron": "node node_modules/electron/install.js",
    "setup:macos-signing": "node scripts/setup-macos-signing.mjs",
    "package:macos": "npm run build && node scripts/package-macos.mjs",
    "install:macos": "node scripts/install-macos.mjs --launch",
    "cli": "node scripts/run-cli.mjs",
    "package:portable": "npm run build && node scripts/package-portable.mjs",
    "package:windows-preview": "npm run build && node scripts/package-windows-preview.mjs",
    "package:windows-stable": "npm run build && node scripts/package-windows-stable.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "42.11.8",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "typescript": "^5.8.0"
  }
}
